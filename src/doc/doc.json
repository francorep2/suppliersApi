          }
        }
      },
      "UserRequest": {
        "type": "object",
        "description": "Request para operaciones administrativas sobre usuarios",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "ID del usuario",
            "example": "c47e6af2-1234-5678-9abc-def123456789"
          },
          "active": {
            "type": "boolean",
            "description": "Estado activo del usuario",
            "example": true
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "description": "Fecha de expiración del usuario",
            "example": "2026-12-31"
          }
        }
      },
      "ApisResponseVoid": {
        "type": "object",
        "description": "Estructura base de respuesta de la API",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Indica si la operación fue exitosa",
            "example": true
          },
          "message": {
            "type": "string",
            "description": "Mensaje descriptivo de la respuesta",
            "example": "Operation successful"
          },
          "data": {
            "description": "Datos de respuesta (depende del endpoint)"
          }
        }
      },
      "ProductDTO": {
        "type": "object",
        "description": "Representación de un producto unificado entre proveedores",
        "properties": {
          "provider": {
            "type": "string",
            "description": "Nombre del proveedor que devuelve el producto",
            "example": "NEW_BYTES"
          },
          "name": {
            "type": "string",
            "description": "Nombre del producto",
            "example": "PROCESADOR AMD (AM4) RYZEN 7 5700G"
          },
          "price": {
            "type": "string",
            "description": "Precio del producto en USD",
            "example": 120
          },
          "imageUrl": {
            "type": "string",
            "description": "URL de la imagen del producto",
            "example": "https://example.com/image.jpg"
          },
          "externalId": {
            "type": "string",
            "description": "ID externo del producto en el proveedor",
            "example": "ABC123"
          }
        }
      },
      "CredentialRequest": {
        "type": "object",
        "description": "Request para crear o actualizar credenciales de un proveedor",
        "properties": {
          "providerName": {
            "type": "string",
            "description": "Nombre del proveedor",
            "enum": [
              "NEW_BYTES",
              "ELIT",
              "GRUPO_NUCLEO",
              "AIR",
              "NEW_TREE",
              "INVID",
              "GC",
              "POLYTECH",
              "ASHIR",
              "HDC",
              "SOLUTION_BOX",
              "DISTECNA",
              "CEVEN",
              "DIAPSTORE"
            ],
            "example": "INVID"
          },
          "credentials": {
            "type": "object",
            "additionalProperties": {

            },
            "description": "Credenciales dinámicas del proveedor (keys variables según proveedor)",
            "example": {
              "apiKey": "123456",
              "secret": "abcde"
            }
          }
        }
      },
      "CredentialResponse": {
        "type": "object",
        "description": "Respuesta de credenciales de proveedor",
        "properties": {
          "providerName": {
            "type": "string",
            "description": "Nombre del proveedor",
            "enum": [
              "NEW_BYTES",
              "ELIT",
              "GRUPO_NUCLEO",
              "AIR",
              "NEW_TREE",
              "INVID",
              "GC",
              "POLYTECH",
              "ASHIR",
              "HDC",
              "SOLUTION_BOX",
              "DISTECNA",
              "CEVEN",
              "DIAPSTORE"
            ],
            "example": "INVID"
          },
          "credentialsJson": {
            "type": "string",
            "description": "Credenciales del proveedor en formato JSON serializado",
            "example": {
              "username": "userAdmin",
              "password": "a2dfg"
            }
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "description": "Request para registro de usuario",
        "properties": {
          "username": {
            "type": "string",
            "description": "Nombre de usuario único",
            "example": "admin"
          },
          "password": {
            "type": "string",
            "description": "Contraseña del usuario",
            "example": 123456
          }
        }
      },
      "ApisResponseRegisterResponse": {
        "type": "object",
        "description": "Estructura base de respuesta de la API",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Indica si la operación fue exitosa",
            "example": true
          },
          "message": {
            "type": "string",
            "description": "Mensaje descriptivo de la respuesta",
            "example": "Operation successful"
          },
          "data": {
