            "description": "Datos de respuesta (depende del endpoint)"
          }
        }
      },
      "RegisterResponse": {
        "type": "object",
        "description": "Respuesta de registro de usuario",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "ID único del usuario",
            "example": "c47e6af2-1234-5678-9abc-def123456789"
          },
          "username": {
            "type": "string",
            "description": "Nombre de usuario registrado",
            "example": "admin"
          },
          "role": {
            "type": "string",
            "description": "Rol asignado al usuario",
            "enum": [
              "ROLE_USER",
              "ROLE_ADMIN"
            ],
            "example": "ROLE_ADMIN"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
